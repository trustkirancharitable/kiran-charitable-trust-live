# Frontend API Base URL
# Leave empty or set to /api for unified monorepo deployment on Vercel
# If deploying frontend and backend to separate Vercel projects, specify the backend URL:
# VITE_API_BASE_URL=https://your-backend-project.vercel.app/api
VITE_API_BASE_URL=/api

# Google OAuth Client ID for Google Sign In
VITE_GOOGLE_CLIENT_ID=112958573430-6om91638bbj2mkasm39l9osf1ndogg5f.apps.googleusercontent.com

# Cloudflare Turnstile Site Key for Bot Protection
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAF3oisZMx3i94jFK
