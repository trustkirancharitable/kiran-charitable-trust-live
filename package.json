{
  "name": "kiran-charitable-trust-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Kiran Charitable Trust Web Application & API",
  "scripts": {
    "build": "npm install && cd frontend && npm install && npm run build",
    "install-frontend": "cd frontend && npm install",
    "install-backend": "cd backend && npm install",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "start": "node backend/server.js",
    "start:cluster": "node backend/cluster.js",
    "start:pm2": "pm2 start ecosystem.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.4"
  }
}
